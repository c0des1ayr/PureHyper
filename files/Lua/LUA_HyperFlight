local PH = PureHyper
local FC = PH.tables.FlyingChars
local SF = PH.tables.StatesFlying
local HK = PH.hooklib
local playerValid = PH.functions.playerValid
local superCheck = PH.functions.superCheck
HK.addHook('PlayerThink', function(p)
    -- Only FlyingChars can fly
    if not (playerValid(p) and FC[p.mo.skin] == true) then
        return
    end

    -- Only Hyper people can fly
    if not (superCheck(p) == 2) then
        -- Take your old ability back, normie, we're done here
        if p.eggoldability ~= nil then
            p.charability = p.eggoldability
            p.eggoldability = nil
        end
        -- Non-hyper people can't be flying
        p.eggsuperflying = false
        return
    end

    -- Not not a FlyingChar, not not Hyper, must be a Hyper FlyingChar!
    -- Can't go flying if you're in a minecart or a zoom tube
    if p.mo.state == S_PLAY_RIDE or p.powers[pw_carry] == CR_ZOOMTUBE then
        return
    end

    -- Definitely flying, so initialise/confirm flying-related variables
    p.eggsuperflying = $ or false  -- Boolean for whether Hyper Sonic is flying
    p.eggflystart = $ or false -- Boolean for whether Hyper Sonic just started flying
    p.eggflyboost = $ or false  -- Boolean for whether Hyper Sonic can boost this tic
	p.boostnumer = $ or false -- Boolean for if Hyper Sonic can nuke enemies
    p.eggboostcost = 5  -- How many rings it costs to boost
    p.eggmaxvert = 22*FRACUNIT  -- Maximum vertical flying speed in either direction
    p.eggoldability = $ or CA_NONE -- Storage for non-super jump ability

    -- If you still have a jump ability, take it away and remember what it was
    if p.eggsuperflying == true then
        p.charability = CA_NONE
	else
		p.charability = p.eggoldability
    end

    -- You stop flying when you touch the ground
    if P_IsObjectOnGround(p.mo) then
        p.eggsuperflying = false
    else
    -- Prevent rolling when holding spin and touching ground while flying.
        if p.eggsuperflying == true then
			p.pflags = $ | PF_THOKKED
		end
    end

    -- If you're not flying right now, we're done here.
    if not p.eggsuperflying then
        return
    end

    -- Gravity doesn't apply when you're flying
    p.mo.momz = $-P_GetMobjGravity(p.mo)

    -- You can't fall when you're flying
    if SF[p.mo.state] == true then
		if p.speed >= FixedMul(p.runspeed, p.mo.scale) then
			p.mo.state = S_PLAY_FLOAT_RUN
		else
            p.mo.state = S_PLAY_FLOAT
		end
    end

    -- You're not jumping or spinning when you're flying
	p.pflags = $ & ~(PF_JUMPED|PF_SPINNING)

    -- You have to let go of jump after you start floating before you can ascend
    if not (p.cmd.buttons & BT_SPIN) then
        p.eggflystart = false
    end

	--Prevent stored momentum when initiating hover
	if p.eggflystart == true then
		P_SetObjectMomZ(p.mo, 0, false)
	end

    -- You have to let go of either jump or spin after boosting before you can boost again
    p.eggflyboost = true


    -- If you're holding jump and not spin, accelerate up
    if (p.cmd.buttons & BT_JUMP) and not (p.cmd.buttons & BT_USE) and not p.eggflystart
    or (p.cmd.buttons & BT_JUMP) and not (p.cmd.buttons & BT_USE) then
        if not ((p.cmd.buttons & BT_CUSTOM1) and (p.eggc1helper == false)) then
			P_SetObjectMomZ(p.mo, 1*FRACUNIT, true) -- Accelerate up
		end
    end

    -- If you're holding spin and not jump, accelerate down
    if (p.cmd.buttons & BT_USE) and not (p.cmd.buttons & BT_JUMP) then
		if not ((p.cmd.buttons & BT_CUSTOM1) and (p.eggc1helper == false)) then
			if p.eggflystart == false then
				P_SetObjectMomZ(p.mo, -1*FRACUNIT, true)
			end
		end
    end


    -- Cap the max flying speed at both ends
    p.mo.momz = max(min(p.eggmaxvert, p.mo.momz), 0 - p.eggmaxvert)

    -- If you're holding both, and you're allowed to boost, and you can pay for it, boost
    if (p.cmd.buttons & BT_JUMP) and (p.cmd.buttons & BT_USE)
    or (p.cmd.buttons & BT_CUSTOM1) and p.eggc1helper == false and p.eggflyboost then
        P_InstaThrust(p.mo, p.mo.angle, 150*FRACUNIT)
		if p.boostnuker == true then
			P_NukeEnemies(p.mo, p.mo, 300*FRACUNIT)
            if p.hyperflash then
                P_FlashPal(p, PAL_WHITE, 10)
            end
			S_StartSound(p.mo, sfx_spdash)
			if (p == displayplayer) then
				P_StartQuake(50*FRACUNIT, 15)
			end
		else
			if (p == displayplayer) then
				P_StartQuake(3*FRACUNIT, 15)
			end
		end
		if not (S_SoundPlaying(p.mo, sfx_hypbos)) then
			S_StartSound(p.mo, sfx_hypbos)
		end
		p.drawangle = p.mo.angle
		P_SetObjectMomZ(p.mo, 0, false)
        p.eggflyboost = false -- Can't boost if you've just boosted
		p.boostnuker = false
	else
		if (S_SoundPlaying(p.mo, sfx_hypbos)) then
			S_StopSoundByID(p.mo, sfx_hypbos)
		end
		p.boostnuker = true
    end

    -- If you're holding neither, come to a halt
    if not (p.cmd.buttons & BT_JUMP) and not (p.cmd.buttons & BT_USE) then
        p.mo.momz = abs($) > FRACUNIT and $*9/10 or 0
    end
end, "PlayerThink")

HK.addHook("JumpSpinSpecial", function(p)
    if (playerValid(p) and FC[p.mo.skin] == true)
    and superCheck(p) == 2 and not p.eggsuperflying and not (p.pflags & PF_USEDOWN) then
        p.eggsuperflying = true
        p.eggflystart = true
        p.mo.state = S_PLAY_FLOAT
        return true
    end
    return false
end)
